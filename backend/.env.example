# FinPulse Backend Environment Configuration
PORT=3000
NODE_ENV=production

# MySQL Database Configuration (cPanel or Cloud MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=cpanel_finpulse_user
DB_PASSWORD=your_secure_db_password
DB_NAME=cpanel_finpulse_db
DB_CONNECTION_LIMIT=10

# Security & Authentication
JWT_SECRET=replace_with_a_very_secure_random_64_char_string
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# AI Provider Configurations (Server-Side Secrets)
AI_PROVIDER=GEMINI
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=optional_openai_api_key_here

# Client CORS Origins
CLIENT_ORIGIN=*
