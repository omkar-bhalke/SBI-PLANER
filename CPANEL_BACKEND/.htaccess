# =====================================================================
# FinPulse cPanel Apache / LiteSpeed Configuration
# Domain: https://radhewins.buzz
# =====================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Ensure HTTPS
    # Uncomment the two lines below if your cPanel does not automatically force HTTPS
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Pass Authorization Header to PHP in cPanel FastCGI / LiteSpeed / PHP-FPM
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Pass X-Device-Id Header
    RewriteCond %{HTTP:X-Device-Id} .
    RewriteRule .* - [E=HTTP_X_DEVICE_ID:%{HTTP:X-Device-Id}]

    # Handle OPTIONS Preflight Requests directly
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ index.php [QSA,L]

    # Route all /api/(.*) requests to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/(.*)$ index.php?route=$1 [QSA,L]

    # Route any other direct request not matching a real file/dir to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]
</IfModule>

# Security: Prevent direct web access to sensitive SQL and config files
<FilesMatch "\.(sql|log|ini|sh|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent directory indexing
Options -Indexes
